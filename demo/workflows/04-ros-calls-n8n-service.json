{
  "id": "demo-04-service-trigger",
  "name": "04 - ROS Calls n8n (Service Trigger)",
  "nodes": [
    {
      "parameters": {
        "serviceName": "/n8n/mission_report",
        "serviceType": "std_srvs/srv/Trigger",
        "responseInputMode": "raw",
        "responseJson": "={{ JSON.stringify({ success: true, message: 'Mission report generated by n8n at ' + $now.toISO() + '. Ask the rover for /rover/status for live values.' }) }}"
      },
      "id": "report-service",
      "name": "Advertise /n8n/mission_report",
      "type": "@fhnw-rover/n8n-nodes-ros2.rosServiceTrigger",
      "typeVersion": 1,
      "position": [-140, 0],
      "credentials": {
        "rosBridgeApi": {
          "id": "demo-rosbridge",
          "name": "ROS2 Rosbridge (Demo Rover)"
        }
      }
    },
    {
      "parameters": {
        "topicName": {
          "__rl": true,
          "mode": "id",
          "value": "/rover/status"
        },
        "messageType": {
          "__rl": true,
          "mode": "id",
          "value": "rover_interfaces/msg/RoverStatus"
        },
        "conditions": {},
        "options": {},
        "timeoutMs": 10000
      },
      "id": "report-status",
      "name": "Read Current Status",
      "type": "@fhnw-rover/n8n-nodes-ros2.rosTopicNextMessage",
      "typeVersion": 1,
      "position": [100, 0],
      "credentials": {
        "rosBridgeApi": {
          "id": "demo-rosbridge",
          "name": "ROS2 Rosbridge (Demo Rover)"
        }
      }
    },
    {
      "parameters": {
        "topicName": {
          "__rl": true,
          "mode": "id",
          "value": "/rover/notifications"
        },
        "messageType": {
          "__rl": true,
          "mode": "id",
          "value": "std_msgs/msg/String"
        },
        "messageInputMode": "raw",
        "messageJson": "={{ JSON.stringify({ data: 'Mission report: state=' + $json.message.state + ', battery=' + Math.round($json.message.battery.percentage) + '%, position=(' + $json.message.pose.x.toFixed(1) + ', ' + $json.message.pose.y.toFixed(1) + ')' }) }}",
        "options": {}
      },
      "id": "report-publish",
      "name": "Publish the Report",
      "type": "@fhnw-rover/n8n-nodes-ros2.rosTopicPublish",
      "typeVersion": 1,
      "position": [340, 0],
      "credentials": {
        "rosBridgeApi": {
          "id": "demo-rosbridge",
          "name": "ROS2 Rosbridge (Demo Rover)"
        }
      }
    }
  ],
  "connections": {
    "Advertise /n8n/mission_report": {
      "main": [[{ "node": "Read Current Status", "type": "main", "index": 0 }]]
    },
    "Read Current Status": {
      "main": [[{ "node": "Publish the Report", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
