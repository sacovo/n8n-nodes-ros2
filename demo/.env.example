# Copy to .env and fill in before running `./setup.sh --public`, which validates
# these values. Local runs (`./setup.sh`) work without any of this.

# Domain for the n8n editor. Must have an A/AAAA record pointing at this server.
N8N_DOMAIN=n8n.example.org

# Domain for the public read-only robot viewer.
VIEWER_DOMAIN=robot.example.org

# Public URL of n8n. Used for webhook and form URLs, so it must match N8N_DOMAIN.
N8N_PUBLIC_URL=https://n8n.example.org
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true

# Address Let's Encrypt uses for expiry notices.
ACME_EMAIL=you@example.org

# Encrypts stored credentials. Generate once with `openssl rand -hex 24` and
# never change it afterwards, or n8n can no longer read its saved credentials.
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-24

TIMEZONE=Europe/Zurich

# How long to keep execution history, in hours.
EXECUTIONS_MAX_AGE_HOURS=2

# Optional: skip building n8n from source by using a prebuilt image.
# N8N_IMAGE=ghcr.io/sacovo/n8n:master
