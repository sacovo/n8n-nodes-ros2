{
	"name": "@fhnw-rover/n8n-nodes-ros2",
	"version": "0.3.0",
	"description": "ROS2 rosbridge integration for n8n workflows.",
	"license": "MIT",
	"homepage": "https://github.com/fhnw-rover/n8n/n8n-nodes-ros2",
	"keywords": [
		"n8n-community-node-package"
	],
	"author": {
		"name": "Sandro Covo",
		"email": "sandro.covo@fhnw.ch"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/fhnw-rover/n8n/n8n-nodes-ros2.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"install-global": "npm install -g roslib@2.1.0 lodash",
		"n8n": "n8n",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/RosBridgeApi.credentials.js",
			"dist/credentials/DockerApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/DockerContainer/DockerContainer.node.js",
			"dist/nodes/RosTopicTrigger/RosTopicTrigger.node.js",
			"dist/nodes/RosTopicNextMessage/RosTopicNextMessage.node.js",
			"dist/nodes/RosTopicPublish/RosTopicPublish.node.js",
			"dist/nodes/RosTopicCaptureImage/RosTopicCaptureImage.node.js",
			"dist/nodes/RosServiceCall/RosServiceCall.node.js",
			"dist/nodes/RosServiceTrigger/RosServiceTrigger.node.js",
			"dist/nodes/RosActionStart/RosActionStart.node.js",
			"dist/nodes/RosActionTrigger/RosActionTrigger.node.js",
			"dist/nodes/RosActionSendFeedback/RosActionSendFeedback.node.js",
			"dist/nodes/RosActionStatus/RosActionStatus.node.js",
			"dist/nodes/RosActionResult/RosActionResult.node.js",
			"dist/nodes/RosActionCancel/RosActionCancel.node.js",
			"dist/nodes/RosActionFeedback/RosActionFeedback.node.js",
			"dist/nodes/RosApi/RosApi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.23.1",
		"@types/dockerode": "^4.0.1",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.24",
		"@types/node": "^20.10.6",
		"eslint": "9.32.0",
		"jest": "^29.7.0",
		"n8n": "^2.18.7",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"ts-jest": "^29.1.1",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"dockerode": "^4.0.10",
		"lodash": "^4.18.1",
		"roslib": "^2.1.0"
	}
}
